NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://asyl:replace_with_a_long_random_password@127.0.0.1:5432/asyl
POSTGRES_PASSWORD=replace_with_a_long_random_password
# At least 32 random characters. Never commit the real value.
SESSION_SECRET=replace_with_at_least_32_random_characters
# Exact origins, no paths and no wildcard. Add your real frontend origin in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
SITE_URL=http://localhost:3001
SESSION_TTL_HOURS=8
SESSION_ROTATE_MINUTES=30
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Empty means same-origin /api. Public value, embedded in client bundle.
VITE_API_URL=
VITE_SITE_URL=http://localhost:3001
VITE_BASE_PATH=/
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=
# Disable until approved legal texts and school details are ready.
VITE_APPLICATIONS_ENABLED=false
# Optional notifications; only application ID + language are sent, not contact data.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=
# Used only by npm run admin:create, not by seed. Prefer hidden interactive prompt.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# HTTPS origin of the configured Umami instance for the server CSP; empty disables external origins.
ANALYTICS_ORIGIN=
APPLICATIONS_ENABLED=false
