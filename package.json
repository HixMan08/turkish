{
  "name": "asyl-platform",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate && npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "admin:create": "tsx server/src/admin-create.ts",
    "setup": "node scripts/setup-env.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "prisma": "7.10.1",
    "vitest": "5.0.5",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "@types/node": "26.6.6",
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-socket": "0.2.17"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "picomatch": "4.0.7",
    "postcss-selector-parser": "7.1.7"
  }
}